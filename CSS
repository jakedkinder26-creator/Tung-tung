body{
    margin:0;
    background:#87CEEB;
    font-family:Arial;
    overflow:hidden;
}

#game{
    width:300px;
    height:600px;
    background:#777;
    margin:20px auto;
    position:relative;
    overflow:hidden;
    border:5px solid black;
}

.lane{
    position:absolute;
    top:0;
    width:100px;
    height:600px;
    border-left:1px solid white;
    border-right:1px solid white;
}

#player{
    width:40px;
    height:40px;
    background:dodgerblue;
    position:absolute;
    bottom:50px;
    left:130px;
    border-radius:8px;
}

.obstacle{
    width:50px;
    height:50px;
    background:red;
    position:absolute;
}

#score{
    text-align:center;
    font-size:28px;
    margin-top:10px;
}

#chaser{
    position:absolute;
    bottom:5px;
    left:10px;
    color:white;
    font-weight:bold;
    font-size:18px;
}

.hidden{
    display:none;
}

#gameOver{
    position:absolute;
    width:100%;
    top:150px;
    text-align:center;
    color:white;
}
